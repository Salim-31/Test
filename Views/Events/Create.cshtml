@model Test.Models.EventRecord
@using Test.Models
@{
    ViewData["Title"] = "Create Event";
}

<h1 class="h3 mb-4">Create New Event</h1>

<form asp-action="Create" method="post" class="col-md-8">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Event Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label">Event Type</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<EventType>()" class="form-select"></select>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="EventDate" class="form-label">Event Date</label>
            <input asp-for="EventDate" type="date" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label asp-for="StartTime" class="form-label">Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label asp-for="EndTime" class="form-label">End Time</label>
            <input asp-for="EndTime" type="time" class="form-control" required />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location" class="form-control" required />
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="TotalBudget" class="form-label">Total Budget (₱)</label>
            <input asp-for="TotalBudget" type="number" step="0.01" min="0" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label asp-for="ExpectedGuests" class="form-label">Expected Guests</label>
            <input asp-for="ExpectedGuests" type="number" min="1" class="form-control" required />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="SpecialRequirements" class="form-label">Special Requirements</label>
        <textarea asp-for="SpecialRequirements" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Event</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>