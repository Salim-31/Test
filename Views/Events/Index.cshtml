@model List<Test.Models.EventRecord>
@{
    ViewData["Title"] = "My Events";
}
@{
    var all = Test.Controllers.EventsController.events;
}

<div class="row g-3 mb-4 text-center">
    <div class="col">
        <div class="card"><div class="card-body">
            <div class="fs-3 fw-bold">@all.Count</div>
            <div class="text-muted">Total</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body">
            <div class="fs-3 fw-bold">@all.Count(e => e.Status == Test.Models.EventStatus.Upcoming)</div>
            <div class="text-muted">Upcoming</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body">
            <div class="fs-3 fw-bold">@all.Count(e => e.Status == Test.Models.EventStatus.Ongoing)</div>
            <div class="text-muted">Ongoing</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body">
            <div class="fs-3 fw-bold">@all.Count(e => e.Status == Test.Models.EventStatus.Completed)</div>
            <div class="text-muted">Completed</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card"><div class="card-body">
            <div class="fs-3 fw-bold">@all.Count(e => e.Status == Test.Models.EventStatus.Cancelled)</div>
            <div class="text-muted">Cancelled</div>
        </div></div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My Events</h1>
    <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
</div>

<form method="get" class="mb-4">
    <input type="text" name="search" placeholder="Search events" />
    <button type="submit">Search</button>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no events yet.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Type</th>
                <th>Date</th>
                <th>Location</th>
                <th class="text-end">Budget</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td class="fw-semibold">@e.Name</td>
                    <td>@e.Type</td>
                    <td>@e.EventDate.ToString("MMM dd, yyyy")</td>
                    <td>@e.Location</td>
                    <td class="text-end">₱@e.TotalBudget.ToString("N2")</td>
                    <td>@e.Status</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}