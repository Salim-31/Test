@using Test.Models
@{
    ViewData["Title"] = "Create Package";

    var organizer = (Organizer)ViewBag.Organizer;
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var services = (List<SupplierService>)ViewBag.Services;
}

<h1 class="h3 mb-1">Create Package</h1>
<p class="text-muted mb-4">Logged in as: <strong>@organizer.Name</strong></p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="CreatePackage" method="post" class="col-md-8">
    <input type="hidden" name="organizerId" value="@organizer.Id" />

    <div class="mb-3">
        <label class="form-label">Package Name</label>
        <input type="text" name="name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="2"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Included Services</label>
        @if (!services.Any())
        {
            <div class="alert alert-info">No services available from your partner suppliers yet.</div>
        }
        else
        {
            @foreach (var s in services)
            {
                <div class="form-check">
                    <input type="checkbox" name="serviceIds" value="@s.Id" class="form-check-input" id="service@(s.Id)" />
                    <label class="form-check-label" for="service@(s.Id)">
                        @s.Name
                        <span class="text-muted">
                            - @suppliers.FirstOrDefault(x => x.Id == s.SupplierId)?.Name, ₱@s.Price.ToString("N2")
                        </span>
                    </label>
                </div>
            }
        }
    </div>

    <p class="text-muted">The package price is the total of the services you pick.</p>

    <button type="submit" class="btn btn-primary">Save Package</button>
    <a asp-action="Packages" asp-route-organizerId="@organizer.Id" class="btn btn-outline-secondary">Cancel</a>
</form>