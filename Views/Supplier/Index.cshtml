@model List<Test.Models.SupplierBooking>
@using Test.Models
@{
    ViewData["Title"] = "Supplier Bookings";
    var supplier = (Supplier)ViewBag.Supplier;
}

<h1 class="h3 mb-1">Booking Requests</h1>
<p class="text-muted">Logged in as: <strong>@supplier.Name</strong></p>

<p class="small">
    Switch supplier (testing only):
    @foreach (var s in Test.Controllers.CatalogController.suppliers)
    {
        <a asp-action="Index" asp-route-supplierId="@s.Id" class="me-2">@s.Name</a>
    }
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No booking requests yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Service</th>
                <th>Date</th>
                <th>Time</th>
                <th class="text-end">Price</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                var ev = Test.Controllers.EventsController.events.FirstOrDefault(e => e.Id == b.EventId);
                <tr>
                    <td>@ev?.Name</td>
                    <td>@b.ServiceName @(b.IsFromPackage ? "(package)" : "")</td>
                    <td>@b.BookingDate.ToString("MMM dd, yyyy")</td>
                    <td>@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</td>
                    <td class="text-end">₱@b.Price.ToString("N2")</td>
                    <td>@b.Status</td>
                    <td class="text-end">
                        @if (b.Status == BookingStatus.Pending)
                        {
                            <form asp-action="Accept" method="post" class="d-inline">
                                <input type="hidden" name="bookingId" value="@b.Id" />
                                <input type="hidden" name="supplierId" value="@supplier.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Accept</button>
                            </form>
                            <form asp-action="Decline" method="post" class="d-inline">
                                <input type="hidden" name="bookingId" value="@b.Id" />
                                <input type="hidden" name="supplierId" value="@supplier.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Decline</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}